# dependencies
node_modules/
.pnp
.pnp.js

# builds
dist/
build/
*.tsbuildinfo

# environment — NEVER commit these, they hold the Pi API key and wallet seed
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
logs/

# database dumps — scoped deliberately. A blanket *.sql also swallows every
# Prisma migration, which leaves `prisma migrate deploy` with nothing to apply
# and the production database empty.
*.sql.gz
/dumps/
pifix-*.sql

# editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# prisma
backend/prisma/*.db
backend/prisma/migrations/dev.db*
