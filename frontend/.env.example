# Frontend environment (Vite exposes only VITE_* to the browser — never put secrets here)

# Backend base URL. Local dev: http://localhost:3000/api
VITE_API_URL=https://pifix-api.onrender.com/api

# Pi SDK sandbox mode. true while the app runs on Testnet.
VITE_PI_SANDBOX=true

# Shown on the "open in Pi Browser" screen and used to build referral links, so
# it must be the pinet address pioneers can actually open — not the Render URL.
#
# WARNING: this is NOT the app slug. PiNet assigns its own subdomain (it appends
# digits), so `pifix-c5u9` (the slug shown in Develop) is almost certainly not
# it. Read the real value in Pi Browser →
#   Develop → My Apps → PiFix (Testnet) → PiNet Settings → "Current PiNet subdomain"
# and paste it here. A wrong value silently breaks every referral link.
VITE_APP_URL=https://REPLACE-ME.pinet.com

# testnet | mainnet. Anything other than "mainnet" stays on the sandbox.
VITE_PI_NETWORK=testnet
