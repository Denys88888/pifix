# Frontend environment (Vite exposes only VITE_* to the browser — never put secrets here)

# Backend base URL. Local dev: http://localhost:3000/api
VITE_API_URL=https://pifix-api.onrender.com/api

# Pi SDK sandbox mode. true while the app runs on Testnet.
VITE_PI_SANDBOX=true

# Shown on the "open in Pi Browser" screen and used to build referral links, so
# it must be the pinet address pioneers can actually open — not the Render URL.
VITE_APP_URL=https://pifix-c5u9.pinet.com
