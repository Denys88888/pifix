# ─────────────────────────────────────────────────────────────
#  PiFix backend — environment variables
#  Copy to .env and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=production
PORT=3000

# PostgreSQL (Render → Internal Database URL)
DATABASE_URL=postgresql://user:password@host:5432/pifix?schema=public

# ── Pi Network ───────────────────────────────────────────────
# Server API Key from Pi Developer Portal (Testnet key while sandbox=true)
PI_API_KEY=your_pi_server_api_key
PI_API_BASE_URL=https://api.minepi.com
# true = Testnet / sandbox payments (Protocol v26.1 testnet)
PI_SANDBOX=true
# Require the user to be KYC-verified before creating orders / responding.
# Pi only exposes kyc_status when the app has the scope granted in the portal.
# Set to false while testing on Testnet if the field is not returned.
REQUIRE_KYC=false

# ── App→User payouts (escrow release, withdrawals, referral bonuses) ──
# A2U payments are signed server-side with the app wallet's private seed
# and submitted to the Pi Horizon node. Get the seed from the Developer Portal
# ("App Wallet" → private key). Keep it secret; it controls real funds.
PI_WALLET_PRIVATE_SEED=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PI_HORIZON_URL=https://api.testnet.minepi.com
PI_NETWORK_PASSPHRASE=Pi Testnet
# Set to false to keep payouts as an internal balance only (no on-chain transfer).
PAYOUTS_ENABLED=true

# ── Cloudinary (photos: avatars, portfolio, order photos, documents) ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=pifix

# ── Admin panel (/admin) ─────────────────────────────────────
ADMIN_USERNAME=admin
# bcrypt hash, NOT the plain password. Generate with:
#   npm run hash-admin-password -- 'your-plain-password'
ADMIN_PASSWORD_HASH=$2a$12$replace_me_with_a_real_bcrypt_hash
# Legacy/dev fallback: if set, a plain password is accepted and hashed at boot.
# Leave empty in production.
ADMIN_PASSWORD=

# ── Sessions / tokens ────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d
ADMIN_JWT_EXPIRES_IN=12h

# ── CORS: comma-separated list of allowed origins ────────────
# Real users arrive from the app's *.pinet.com origin. The exact subdomain is
# assigned by PiNet and is NOT the app slug — read it in Pi Browser under
# Develop → PiNet Settings → "Current PiNet subdomain".
# Listing it here is belt-and-braces: app.ts already allows any *.pinet.com host.
CORS_ORIGINS=https://pifix-web.onrender.com,https://REPLACE-ME.pinet.com,http://localhost:5173

# ── Cron / lazy escrow auto-release ──────────────────────────
# Secret required by POST /api/cron/auto-release (cron-job.org).
CRON_SECRET=change_me_too
# Run the in-process node-cron fallback (hourly). Disable if you use cron-job.org.
ENABLE_INTERNAL_CRON=true
# Minimum seconds between two lazy auto-release sweeps triggered by user traffic.
LAZY_SWEEP_INTERVAL_SECONDS=300

# Logging
LOG_LEVEL=info
